# ─────────────────────────────────────────────────────────────────
# Automated Content Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────────
# Choose "openai" or "anthropic"
AI_PROVIDER=openai

# If using OpenAI:
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# If using Anthropic instead:
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5-20251001

# ── Serper (Google Trends / News scraping) ────────────────────────
# Sign up free at https://serper.dev — 2,500 free searches/month
SERPER_API_KEY=your_serper_key_here

# ── Airtable ─────────────────────────────────────────────────────
# Get your API key: https://airtable.com/account
# Base ID: open your base in browser → URL contains appXXXXXXXXXXXXXX
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Content Pipeline

# ── Thumbnail Generation (optional) ──────────────────────────────
# Set to true to generate real DALL-E 3 thumbnails (costs ~$0.04/image)
# Set to false to generate text prompts only (default, free)
ENABLE_IMAGE_GEN=false

# ── Buffer (scheduling + publishing) ─────────────────────────────
# Sign up at https://buffer.com — free for up to 3 channels
# Get token: https://buffer.com/developers/apps
BUFFER_ACCESS_TOKEN=your_buffer_token_here
# Comma-separated list of Buffer profile IDs to publish to
BUFFER_PROFILE_IDS=profile_id_1,profile_id_2

# ── n8n webhook (used when running in n8n orchestration mode) ─────
# Set this if you want to trigger the pipeline from n8n via webhook
# N8N_WEBHOOK_SECRET=your_random_secret_here
